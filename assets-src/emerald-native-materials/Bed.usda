#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
)
def Xform "Root" {
    def Material "Bed" (
        customData = {
            string materialType = "SHADER_GRAPH"
            string blendingMode = "OPAQUE"
            string cullingMode = "NONE"
            bool depthWrite = 1
            bool depthTest = 1
            bool applyToneMapping = 1
        }
    ) {
        token outputs:mtlx:surface.connect = </Root/Bed/Surface.outputs:out>
        def Shader "Surface" {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/Bed/SubmergedTint.outputs:out>
            float inputs:metallic = 0
            float inputs:roughness = 0.91
            float inputs:opacity = 1
            float3 inputs:normal.connect = </Root/Bed/Normal.outputs:out>
            token outputs:out
        }
        def Shader "SubmergedTint" {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1.connect = </Root/Bed/LinearColor.outputs:out>
            color3f inputs:in2 = (0.22, 0.53, 0.38)
            color3f outputs:out
        }
        def Shader "UV" {
            uniform token info:id = "ND_texcoord_vector2"
            int inputs:index = 0
            float2 outputs:out
        }
        def Shader "Albedo" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @C:/Work/AndoidSpatialProject/BugWorld/assets-src/emerald-native-materials/Textures/BankAlbedo.jpg@
            float2 inputs:texcoord.connect = </Root/Bed/UVScale.outputs:out>
            color3f outputs:out
        }
        def Shader "UVScale" {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </Root/Bed/UV.outputs:out>
            float inputs:in2 = 6
            float2 outputs:out
        }
        def Shader "LinearColor" {
            uniform token info:id = "ND_power_color3FA"
            color3f inputs:in1.connect = </Root/Bed/Albedo.outputs:out>
            float inputs:in2 = 2.2
            color3f outputs:out
        }

        def Shader "NormalImage" {
            uniform token info:id = "ND_image_vector3"
            asset inputs:file = @C:/Work/AndoidSpatialProject/BugWorld/assets-src/emerald-native-materials/Textures/BankNormal.jpg@
            float2 inputs:texcoord.connect = </Root/Bed/UVScale.outputs:out>
            float3 outputs:out
        }
        def Shader "Normal" {
            uniform token info:id = "ND_normalmap"
            float3 inputs:in.connect = </Root/Bed/NormalImage.outputs:out>
            float3 inputs:normal = (0, 0, 1)
            float3 inputs:tangent = (1, 0, 0)
            float inputs:scale = 0.2
            string inputs:space = "tangent"
            float3 outputs:out
        }
    }
}
