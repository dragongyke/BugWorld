#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
)
def Xform "Root" {
    def Material "Fern" (
        customData = {
            string materialType = "SHADER_GRAPH"
            string blendingMode = "MASKED"
            float opacityThreshold = 0.45
            string cullingMode = "NONE"
            bool depthWrite = 1
            bool depthTest = 1
            bool applyToneMapping = 1
        }
    ) {
        token outputs:mtlx:surface.connect = </Root/Fern/Surface.outputs:out>
        def Shader "Surface" {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/Fern/LinearColor.outputs:out>
            float inputs:metallic = 0
            float inputs:roughness = 0.8
            float inputs:opacity.connect = </Root/Fern/Alpha.outputs:out>
            float inputs:opacityThreshold = 0.45
            float3 inputs:normal.connect = </Root/Fern/Normal.outputs:out>
            token outputs:out
        }
        def Shader "AlphaImage" {
            uniform token info:id = "ND_image_color4"
            asset inputs:file = @C:/Work/AndoidSpatialProject/BugWorld/assets-src/emerald-native-materials/Textures/fern_02_diff-fern_02_alpha-fern_02_alpha_1k.png@
            float2 inputs:texcoord.connect = </Root/Fern/UVScale.outputs:out>
            color4f outputs:out
        }
        def Shader "Alpha" {
            uniform token info:id = "ND_extract_color4"
            color4f inputs:in.connect = </Root/Fern/AlphaImage.outputs:out>
            int inputs:index = 3
            float outputs:out
        }
        def Shader "UV" {
            uniform token info:id = "ND_texcoord_vector2"
            int inputs:index = 0
            float2 outputs:out
        }
        def Shader "Albedo" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @C:/Work/AndoidSpatialProject/BugWorld/assets-src/emerald-native-materials/Textures/fern_02_diff-fern_02_alpha-fern_02_alpha_1k.png@
            float2 inputs:texcoord.connect = </Root/Fern/UVScale.outputs:out>
            color3f outputs:out
        }
        def Shader "UVScale" {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </Root/Fern/UV.outputs:out>
            float inputs:in2 = 1
            float2 outputs:out
        }
        def Shader "LinearColor" {
            uniform token info:id = "ND_power_color3FA"
            color3f inputs:in1.connect = </Root/Fern/Albedo.outputs:out>
            float inputs:in2 = 2.2
            color3f outputs:out
        }

        def Shader "NormalImage" {
            uniform token info:id = "ND_image_vector3"
            asset inputs:file = @C:/Work/AndoidSpatialProject/BugWorld/assets-src/emerald-native-materials/Textures/fern_02_nor_gl_1k.jpg@
            float2 inputs:texcoord.connect = </Root/Fern/UVScale.outputs:out>
            float3 outputs:out
        }
        def Shader "Normal" {
            uniform token info:id = "ND_normalmap"
            float3 inputs:in.connect = </Root/Fern/NormalImage.outputs:out>
            float3 inputs:normal = (0, 0, 1)
            float3 inputs:tangent = (1, 0, 0)
            float inputs:scale = 0.3
            string inputs:space = "tangent"
            float3 outputs:out
        }
    }
}
