  "scheduledCpuQuery": "SELECT p.name AS process, t.name AS thread, t.tid,\n       ROUND(SUM(s.dur) / 1e9, 6) AS scheduled_cpu_seconds,\n       ROUND((SELECT end_ts-start_ts FROM trace_bounds) / 1e9, 6) AS trace_seconds,\n       ROUND(SUM(s.dur) * 100.0 / (SELECT end_ts-start_ts FROM trace_bounds), 3) AS one_core_percent\nFROM sched s JOIN thread t USING(utid) JOIN process p USING(upid)\nWHERE s.dur > 0 AND\n      ((p.name = 'com.pico.spatial.runtime' AND t.name = 'Eng-Render')\n       OR (p.name = 'com.bugworld.app' AND t.tid = p.pid))\nGROUP BY t.utid;\n",
